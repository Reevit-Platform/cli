"""Signed Reevit webhook blueprint for Flask.

Mount with: app.register_blueprint(reevit_webhooks)
Local dev: reevit listen --forward-to http://localhost:5000/webhooks/reevit
"""

import json
import os

from flask import Blueprint, Response, request
from reevit import verify_webhook_signature

reevit_webhooks = Blueprint("reevit_webhooks", __name__)


@reevit_webhooks.post("/webhooks/reevit")
def reevit_webhook() -> Response:
    raw_body = request.get_data(cache=True)
    signature = request.headers.get("x-reevit-signature")
    secret = os.environ.get("REEVIT_WEBHOOK_SECRET", "")

    if not verify_webhook_signature(raw_body, signature, secret):
        return Response("invalid signature", status=401)

    event = json.loads(raw_body)
    if event.get("type") == "payment.succeeded":
        pass  # TODO: fulfil the order for event["data"]
    elif event.get("type") == "payment.failed":
        pass  # TODO: notify the customer / retry logic

    return Response("ok", status=200)
