<script{{if .TS}} lang="ts"{{end}}>
  import { ReevitCheckout } from "@reevit/svelte";
  import "@reevit/svelte/styles.css";

  // reevit-checkout-config: {{.ConfigID}}
  const checkoutFields = {
    amount: {{.CollectAmount}},
    name: {{.CollectName}},
    email: {{.CollectEmail}},
    phone: {{.CollectPhone}},
    reference: {{.CollectRef}},
  };
  const metadataFields{{if .TS}}: string[]{{end}} = [{{range .MetadataFields}}{{quote .}}, {{end}}];

  // Customer fields become customer_name/customer_email/customer_phone workflow
  // values. Custom metadata keys become metadata_<key> workflow values.
  export let amount{{if .TS}}: number{{end}} = 5000;
  export let currency = "GHS";
  export let metadata{{if .TS}}: Record<string, unknown>{{end}} = {};

  let open = false;
  let checkoutAmount = amount;
  let customerName = "";
  let email = "";
  let phone = "";
  let reference = "";
  let customMetadata = Object.fromEntries(
    metadataFields.map((field) => [field, ""]),
  );
  $: paymentMetadata = {
    ...metadata,
    ...customMetadata,
    ...(customerName ? { customer_name: customerName } : {}),
    ...(email ? { customer_email: email } : {}),
    ...(phone ? { customer_phone: phone } : {}),
    ...(reference ? { reference } : {}),
  };

  function onSuccess(event{{if .TS}}: CustomEvent{{end}}) {
    // TODO: show your confirmation UI
    console.log("payment succeeded", event.detail);
  }

  function onError(event{{if .TS}}: CustomEvent{{end}}) {
    console.error("payment failed", event.detail);
  }
</script>

<form style="display: grid; gap: 12px; max-width: 420px" on:submit|preventDefault={() => (open = true)}>
  {#if checkoutFields.amount}
    <label>
      Amount (smallest currency unit)
      <input bind:value={checkoutAmount} type="number" min="1" required />
    </label>
  {/if}
  {#if checkoutFields.name}
    <label>Name <input bind:value={customerName} required /></label>
  {/if}
  {#if checkoutFields.email}
    <label>Email <input bind:value={email} type="email" required /></label>
  {/if}
  {#if checkoutFields.phone}
    <label>Phone number <input bind:value={phone} type="tel" required /></label>
  {/if}
  {#if checkoutFields.reference}
    <label>Payment reference <input bind:value={reference} required /></label>
  {/if}
  {#each metadataFields as field}
    <label>
      {field.replaceAll("_", " ")}
      <input
        value={customMetadata[field] ?? ""}
        on:input={(event) => {
          customMetadata = { ...customMetadata, [field]: event.currentTarget.value };
        }}
        required
      />
    </label>
  {/each}
  <button type="submit">Pay now</button>
</form>

<ReevitCheckout
  publicKey={import.meta.env.VITE_REEVIT_CHECKOUT_KEY ?? ""}
  amount={checkoutAmount}
  {currency}
  {email}
  {phone}
  {reference}
  customerName={customerName}
  metadata={paymentMetadata}
  paymentMethods={["card", "mobile_money"]}
  isOpen={open}
  on:success={onSuccess}
  on:error={onError}
  on:close={() => (open = false)}
/>
