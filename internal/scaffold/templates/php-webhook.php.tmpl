<?php

// Reevit webhook receiver.
// Signature: X-Reevit-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
// Install: composer require reevit/reevit-php
// Local dev: reevit listen --forward-to http://localhost:8080/reevit-webhook.php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Reevit\Webhooks\SignatureVerifier;

$payload = file_get_contents('php://input');
$signature = $_SERVER['HTTP_X_REEVIT_SIGNATURE'] ?? null;
$secret = getenv('REEVIT_WEBHOOK_SECRET') ?: '';

if (!SignatureVerifier::verify($payload, $signature, $secret)) {
    http_response_code(401);
    echo 'invalid signature';
    exit;
}

$event = json_decode($payload, true);

// Production deliveries name the event in 'event'; `reevit listen`'s fallback
// envelope and older payloads use 'type'. Read both.
$eventType = $event['event'] ?? $event['type'] ?? '';

switch ($eventType) {
    case 'payment.succeeded':
        // TODO: fulfil the order for $event['data']
        break;
    case 'payment.failed':
        // TODO: notify the customer / retry logic
        break;
}

http_response_code(200);
echo 'ok';
