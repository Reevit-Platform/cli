package main

// Reevit webhook receiver.
// Signature: X-Reevit-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
// The verifier is inlined — the Go SDK's webhooks package signs OUTBOUND
// provider payloads and does not verify Reevit's inbound signature.
// Local dev: reevit listen --forward-to http://localhost:8080/webhooks/reevit

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"io"
	"net/http"
	"os"
	"strings"
	"sync"
	"time"
)

// Reevit signs delivery_id, attempt and signature_timestamp into the BODY —
// the same bytes the signature covers — so a handler can refuse a replayed
// capture and acknowledge a retry without doing the work twice. They also
// arrive as X-Reevit-Delivery-ID and X-Reevit-Signature-Timestamp headers.
const (
	reevitWebhookToleranceSeconds = 300
	reevitDedupeLimit             = 1000
)

// Replace with a persistent store (database unique index on delivery_id) before production.
var (
	reevitSeenMu    sync.Mutex
	reevitSeen      = make(map[string]struct{}, reevitDedupeLimit)
	reevitSeenOrder []string
)

func reevitSignatureIsStale(timestamp string) bool {
	at, err := time.Parse(time.RFC3339, timestamp)
	if err != nil {
		return true
	}

	drift := time.Since(at)
	if drift < 0 {
		drift = -drift
	}

	return drift > reevitWebhookToleranceSeconds*time.Second
}

func reevitIsDuplicate(deliveryID string) bool {
	if deliveryID == "" {
		return false
	}

	reevitSeenMu.Lock()
	defer reevitSeenMu.Unlock()

	if _, seen := reevitSeen[deliveryID]; seen {
		return true
	}

	reevitSeen[deliveryID] = struct{}{}
	reevitSeenOrder = append(reevitSeenOrder, deliveryID)

	if len(reevitSeenOrder) > reevitDedupeLimit {
		delete(reevitSeen, reevitSeenOrder[0])
		reevitSeenOrder = reevitSeenOrder[1:]
	}

	return false
}

func verifyReevitSignature(payload []byte, signature, secret string) bool {
	const prefix = "sha256="
	if !strings.HasPrefix(signature, prefix) || secret == "" {
		return false
	}

	mac := hmac.New(sha256.New, []byte(secret))
	mac.Write(payload)
	expected := hex.EncodeToString(mac.Sum(nil))

	return hmac.Equal([]byte(expected), []byte(strings.TrimPrefix(signature, prefix)))
}

// HandleReevitWebhook is an http.HandlerFunc for POST /webhooks/reevit.
func HandleReevitWebhook(w http.ResponseWriter, r *http.Request) {
	payload, err := io.ReadAll(r.Body)
	if err != nil {
		http.Error(w, "read body", http.StatusBadRequest)
		return
	}

	if !verifyReevitSignature(payload, r.Header.Get("X-Reevit-Signature"), os.Getenv("REEVIT_WEBHOOK_SECRET")) {
		http.Error(w, "invalid signature", http.StatusUnauthorized)
		return
	}

	var event struct {
		Event              string          `json:"event"`
		Type               string          `json:"type"` // legacy — `reevit listen`'s fallback envelope still emits this
		Data               json.RawMessage `json:"data"`
		DeliveryID         string          `json:"delivery_id"`
		SignatureTimestamp string          `json:"signature_timestamp"`
	}

	if err := json.Unmarshal(payload, &event); err != nil {
		http.Error(w, "invalid payload", http.StatusBadRequest)
		return
	}

	// A struct tag cannot express a fallback, and a missing field is not an
	// unmarshal error — it just leaves the string empty. Resolve here instead.
	eventType := event.Event
	if eventType == "" {
		eventType = event.Type
	}

	signatureTimestamp := event.SignatureTimestamp
	if signatureTimestamp == "" {
		signatureTimestamp = r.Header.Get("X-Reevit-Signature-Timestamp")
	}

	if reevitSignatureIsStale(signatureTimestamp) {
		http.Error(w, "stale signature timestamp", http.StatusBadRequest)

		return
	}

	deliveryID := event.DeliveryID
	if deliveryID == "" {
		deliveryID = r.Header.Get("X-Reevit-Delivery-ID")
	}

	if reevitIsDuplicate(deliveryID) {
		// Already handled. Reevit retries until it sees a 2xx, so ack rather
		// than re-dispatch.
		w.WriteHeader(http.StatusOK)

		return
	}

	switch eventType {
	case "payment.succeeded":
		// TODO: fulfil the order for event.Data
	case "payment.failed":
		// TODO: notify the customer / retry logic
	}

	w.WriteHeader(http.StatusOK)
}
