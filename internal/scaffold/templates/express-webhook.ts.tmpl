{{if .TS}}import type { Request, Response, Express } from "express";
{{end}}import express from "express";
import { verifyWebhookSignature } from "@reevit/node";

// Reevit webhook receiver. Mount BEFORE any global express.json() middleware —
// signature verification needs the raw body bytes.
// Local dev: `reevit listen --forward-to http://localhost:3000/webhooks/reevit`

// Reevit signs delivery_id, attempt and signature_timestamp into the BODY —
// the same bytes the signature covers — so a handler can refuse a replayed
// capture and acknowledge a retry without doing the work twice. They also
// arrive as X-Reevit-Delivery-ID and X-Reevit-Signature-Timestamp headers.
const REEVIT_WEBHOOK_TOLERANCE_SECONDS = 300;
const REEVIT_DEDUPE_LIMIT = 1000;

// Replace with a persistent store (database unique index on delivery_id) before production.
const reevitSeenDeliveries = new Set{{if .TS}}<string>{{end}}();

function reevitSignatureIsStale(timestamp{{if .TS}}: string | undefined{{end}}){{if .TS}}: boolean{{end}} {
  const at = Date.parse(timestamp ?? "");

  return (
    Number.isNaN(at) ||
    Math.abs(Date.now() - at) > REEVIT_WEBHOOK_TOLERANCE_SECONDS * 1000
  );
}

function reevitIsDuplicate(deliveryId{{if .TS}}: string | undefined{{end}}){{if .TS}}: boolean{{end}} {
  if (!deliveryId) return false;
  if (reevitSeenDeliveries.has(deliveryId)) return true;

  reevitSeenDeliveries.add(deliveryId);

  if (reevitSeenDeliveries.size > REEVIT_DEDUPE_LIMIT) {
    const oldest = reevitSeenDeliveries.values().next().value;
    if (oldest !== undefined) reevitSeenDeliveries.delete(oldest);
  }

  return false;
}

export function mountReevitWebhook(app{{if .TS}}: Express{{end}}) {
  app.post(
    "/webhooks/reevit",
    express.raw({ type: "application/json" }),
    (req{{if .TS}}: Request{{end}}, res{{if .TS}}: Response{{end}}) => {
      const signature = req.header("x-reevit-signature");

      if (!verifyWebhookSignature(req.body, signature, process.env.REEVIT_WEBHOOK_SECRET ?? "")) {
        res.status(401).send("invalid signature");
        return;
      }

      const event = JSON.parse(req.body.toString("utf8"));

      // Production deliveries name the event in `event`; `reevit listen`'s
      // fallback envelope and older payloads use `type`. Read both.
      const eventType = event.event ?? event.type;

      const signatureTimestamp =
        event.signature_timestamp ?? req.header("x-reevit-signature-timestamp");

      if (reevitSignatureIsStale(signatureTimestamp)) {
        res.status(400).send("stale signature timestamp");

        return;
      }

      const deliveryId = event.delivery_id ?? req.header("x-reevit-delivery-id");

      if (reevitIsDuplicate(deliveryId)) {
        // Already handled. Reevit retries until it sees a 2xx, so ack rather
        // than re-dispatch.
        res.status(200).send("ok");

        return;
      }

      // A terminal outcome arrives as `payment.updated` with the result in
      // `data.status`. There is no `payment.succeeded` event — see
      // https://docs.reevit.io/webhooks#event-types.
      switch (eventType) {
        case "payment.updated":
          if (event.data?.status === "succeeded") {
            // TODO: fulfil the order for event.data
          } else if (event.data?.status === "failed") {
            // TODO: notify the customer / retry logic
          }
          break;
        default:
          // payment.created, payment.canceled, payment.expired, refund.*, ...
          break;
      }

      res.status(200).send("ok");
    },
  );
}
