import { verifyWebhookSignature } from "@reevit/node";

// Reevit webhook receiver (App Router).
// Signature: X-Reevit-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
// For local development, `reevit listen --forward-to http://localhost:3000/api/webhooks/reevit`
// forwards signed test-mode events here.
export async function POST(request{{if .TS}}: Request{{end}}) {
  const rawBody = await request.text();
  const signature = request.headers.get("x-reevit-signature");

  if (!verifyWebhookSignature(rawBody, signature, process.env.REEVIT_WEBHOOK_SECRET ?? "")) {
    return new Response("invalid signature", { status: 401 });
  }

  const event = JSON.parse(rawBody);

  // Production deliveries name the event in `event`; `reevit listen`'s
  // fallback envelope and older payloads use `type`. Read both.
  const eventType = event.event ?? event.type;

  switch (eventType) {
    case "payment.succeeded":
      // TODO: fulfil the order for event.data
      break;
    case "payment.failed":
      // TODO: notify the customer / retry logic
      break;
    default:
      break;
  }

  return new Response("ok", { status: 200 });
}
