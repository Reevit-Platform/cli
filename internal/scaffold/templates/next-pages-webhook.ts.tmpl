  response{{if .TS}}: NextApiResponse{{end}},
) {
  if (request.method !== "POST") {
    response.setHeader("Allow", "POST");
    return response.status(405).end();
  }
  const rawBody = await readRawBody(request);
  const rawSignature = request.headers["x-reevit-signature"];
  const signature = Array.isArray(rawSignature) ? rawSignature[0] : rawSignature;
  if (!verifyWebhookSignature(rawBody, signature, process.env.REEVIT_WEBHOOK_SECRET ?? "")) {
    return response.status(401).json({ error: "invalid signature" });
  }
  const event = JSON.parse(rawBody);
  // Production deliveries name the event in `event`; `reevit listen`'s
  // fallback envelope and older payloads use `type`. Read both.
  const eventType = event.event ?? event.type;
  if (eventType === "payment.succeeded") {
    // Fulfil the order represented by event.data.
  }
  return response.status(200).json({ received: true });
}
