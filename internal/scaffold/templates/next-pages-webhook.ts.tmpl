import { verifyWebhookSignature } from "@reevit/node";
{{if .TS}}import type { NextApiRequest, NextApiResponse } from "next";{{end}}

export const config = { api: { bodyParser: false } };

async function readRawBody(request{{if .TS}}: NextApiRequest{{end}}) {
  const chunks = [];
  for await (const chunk of request) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}

// Reevit signs delivery_id, attempt and signature_timestamp into the BODY —
// the same bytes the signature covers — so a handler can refuse a replayed
// capture and acknowledge a retry without doing the work twice. They also
// arrive as X-Reevit-Delivery-ID and X-Reevit-Signature-Timestamp headers.
const REEVIT_WEBHOOK_TOLERANCE_SECONDS = 300;
const REEVIT_DEDUPE_LIMIT = 1000;

// Replace with a persistent store (database unique index on delivery_id) before production.
const reevitSeenDeliveries = new Set{{if .TS}}<string>{{end}}();

function reevitSignatureIsStale(timestamp{{if .TS}}: string | undefined{{end}}){{if .TS}}: boolean{{end}} {
  const at = Date.parse(timestamp ?? "");

  return (
    Number.isNaN(at) ||
    Math.abs(Date.now() - at) > REEVIT_WEBHOOK_TOLERANCE_SECONDS * 1000
  );
}

function reevitIsDuplicate(deliveryId{{if .TS}}: string | undefined{{end}}){{if .TS}}: boolean{{end}} {
  if (!deliveryId) return false;
  if (reevitSeenDeliveries.has(deliveryId)) return true;

  reevitSeenDeliveries.add(deliveryId);

  if (reevitSeenDeliveries.size > REEVIT_DEDUPE_LIMIT) {
    const oldest = reevitSeenDeliveries.values().next().value;
    if (oldest !== undefined) reevitSeenDeliveries.delete(oldest);
  }

  return false;
}

export default async function handler(
  request{{if .TS}}: NextApiRequest{{end}},
  response{{if .TS}}: NextApiResponse{{end}},
) {
  if (request.method !== "POST") {
    response.setHeader("Allow", "POST");
    return response.status(405).end();
  }
  const rawBody = await readRawBody(request);
  const rawSignature = request.headers["x-reevit-signature"];
  const signature = Array.isArray(rawSignature) ? rawSignature[0] : rawSignature;
  if (!verifyWebhookSignature(rawBody, signature, process.env.REEVIT_WEBHOOK_SECRET ?? "")) {
    return response.status(401).json({ error: "invalid signature" });
  }
  const event = JSON.parse(rawBody);
  // Production deliveries name the event in `event`; `reevit listen`'s
  // fallback envelope and older payloads use `type`. Read both.
  const eventType = event.event ?? event.type;

  const rawTimestamp = request.headers["x-reevit-signature-timestamp"];
  const signatureTimestamp =
    event.signature_timestamp ?? (Array.isArray(rawTimestamp) ? rawTimestamp[0] : rawTimestamp);

  if (reevitSignatureIsStale(signatureTimestamp)) {
    return response.status(400).json({ error: "stale signature timestamp" });
  }

  const rawDeliveryId = request.headers["x-reevit-delivery-id"];
  const deliveryId =
    event.delivery_id ?? (Array.isArray(rawDeliveryId) ? rawDeliveryId[0] : rawDeliveryId);

  if (reevitIsDuplicate(deliveryId)) {
    // Already handled. Reevit retries until it sees a 2xx, so ack rather than
    // re-dispatch.
    return response.status(200).json({ received: true, duplicate: true });
  }

  if (eventType === "payment.succeeded") {
    // Fulfil the order represented by event.data.
  }
  return response.status(200).json({ received: true });
}
