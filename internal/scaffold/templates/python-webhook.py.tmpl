"""Reevit webhook receiver.

Signature: X-Reevit-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
Install: pip install reevit
Local dev: reevit listen --forward-to http://localhost:8000/webhooks/reevit

Call `handle_reevit_event` with the unmodified request body and the
X-Reevit-Signature header from your HTTP framework.
"""

import json
import os

from reevit import verify_webhook_signature


def handle_reevit_event(raw_body: bytes, signature: str | None) -> bool:
    """Verify and dispatch one webhook delivery. Returns False on bad signature."""
    if not verify_webhook_signature(raw_body, signature, os.environ.get("REEVIT_WEBHOOK_SECRET", "")):
        return False

    event = json.loads(raw_body)

    if event.get("type") == "payment.succeeded":
        pass  # TODO: fulfil the order for event["data"]
    elif event.get("type") == "payment.failed":
        pass  # TODO: notify the customer / retry logic

    return True
