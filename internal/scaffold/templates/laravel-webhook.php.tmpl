<?php

// Signed Reevit webhook route for Laravel.
// Load this file from bootstrap/app.php's withRouting(then: ...) callback:
// Route::middleware('api')->group(base_path('routes/reevit.php'));
// Local dev: reevit listen --forward-to http://localhost:8000/webhooks/reevit

declare(strict_types=1);

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;
use Reevit\Webhooks\SignatureVerifier;

if (!function_exists('reevit_signature_is_stale')) {
    // Reevit signs delivery_id, attempt and signature_timestamp into the BODY —
    // the same bytes the signature covers — so a handler can refuse a replayed
    // capture and acknowledge a retry without doing the work twice. They also
    // arrive as X-Reevit-Delivery-ID and X-Reevit-Signature-Timestamp headers.
    define('REEVIT_WEBHOOK_TOLERANCE_SECONDS', 300);
    define('REEVIT_DEDUPE_LIMIT', 1000);

    function reevit_signature_is_stale(?string $timestamp): bool
    {
        if ($timestamp === null || $timestamp === '') {
            return true;
        }

        try {
            $at = new DateTimeImmutable($timestamp);
        } catch (Exception $error) {
            return true;
        }

        return abs(time() - $at->getTimestamp()) > REEVIT_WEBHOOK_TOLERANCE_SECONDS;
    }

    // Replace with a persistent store (database unique index on delivery_id) before production.
    // PHP is shared-nothing: this static survives only the current request (or the
    // current worker under FrankenPHP/Swoole), so on its own it is a stub, not
    // protection.
    function reevit_is_duplicate(?string $deliveryId): bool
    {
        static $seen = [];

        if ($deliveryId === null || $deliveryId === '') {
            return false;
        }

        if (isset($seen[$deliveryId])) {
            return true;
        }

        $seen[$deliveryId] = true;

        if (count($seen) > REEVIT_DEDUPE_LIMIT) {
            array_shift($seen);
        }

        return false;
    }
}

Route::post('/webhooks/reevit', function (Request $request) {
    $payload = $request->getContent();
    $signature = $request->header('X-Reevit-Signature');
    $secret = env('REEVIT_WEBHOOK_SECRET', '');

    if (!SignatureVerifier::verify($payload, $signature, $secret)) {
        return response('invalid signature', 401);
    }

    $event = json_decode($payload, true);

    $signatureTimestamp = $event['signature_timestamp'] ?? $request->header('X-Reevit-Signature-Timestamp');

    if (reevit_signature_is_stale($signatureTimestamp)) {
        return response('stale signature timestamp', 400);
    }

    $deliveryId = $event['delivery_id'] ?? $request->header('X-Reevit-Delivery-ID');

    if (reevit_is_duplicate($deliveryId)) {
        // Already handled. Reevit retries until it sees a 2xx, so ack rather
        // than re-dispatch.
        return response('ok', 200);
    }

    // Production deliveries name the event in 'event'; `reevit listen`'s
    // fallback envelope and older payloads use 'type'. Read both.
    $eventType = $event['event'] ?? $event['type'] ?? '';

    switch ($eventType) {
        case 'payment.succeeded':
            // TODO: fulfil the order for $event['data']
            break;
        case 'payment.failed':
            // TODO: notify the customer / retry logic
            break;
    }

    return response('ok', 200);
});
