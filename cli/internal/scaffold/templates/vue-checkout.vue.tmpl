<script setup{{if .TS}} lang="ts"{{end}}>
import { computed, ref } from "vue";
import { ReevitCheckout } from "@reevit/vue";
import "@reevit/vue/styles.css";

// reevit-checkout-config: {{.ConfigID}}
const checkoutFields = {
  amount: {{.CollectAmount}},
  name: {{.CollectName}},
  email: {{.CollectEmail}},
  phone: {{.CollectPhone}},
  reference: {{.CollectRef}},
};
const metadataFields{{if .TS}}: string[]{{end}} = [{{range .MetadataFields}}{{quote .}}, {{end}}];

// Customer keys match Reevit workflow variables; custom keys become
// metadata_<key> variables in workflow templates.
const props = defineProps({
  amount: { type: Number, default: 5000 },
  currency: { type: String, default: "GHS" },
  metadata: { type: Object, default: () => ({}) },
});

const open = ref(false);
const checkoutAmount = ref(props.amount);
const customerName = ref("");
const email = ref("");
const phone = ref("");
const reference = ref("");
const customMetadata = ref(
  Object.fromEntries(metadataFields.map((field) => [field, ""])),
);
const paymentMetadata = computed(() => ({
  ...props.metadata,
  ...customMetadata.value,
  ...(customerName.value ? { customer_name: customerName.value } : {}),
  ...(email.value ? { customer_email: email.value } : {}),
  ...(phone.value ? { customer_phone: phone.value } : {}),
  ...(reference.value ? { reference: reference.value } : {}),
}));

function onSuccess(result{{if .TS}}: unknown{{end}}) {
  // TODO: show your confirmation UI
  console.log("payment succeeded", result);
}

function onError(error{{if .TS}}: unknown{{end}}) {
  console.error("payment failed", error);
}
</script>

<template>
  <form
    style="display: grid; gap: 12px; max-width: 420px"
    @submit.prevent="open = true"
  >
    <label v-if="checkoutFields.amount">
      Amount (smallest currency unit)
      <input v-model.number="checkoutAmount" type="number" min="1" required>
    </label>
    <label v-if="checkoutFields.name">
      Name
      <input v-model="customerName" required>
    </label>
    <label v-if="checkoutFields.email">
      Email
      <input v-model="email" type="email" required>
    </label>
    <label v-if="checkoutFields.phone">
      Phone number
      <input v-model="phone" type="tel" required>
    </label>
    <label v-if="checkoutFields.reference">
      Payment reference
      <input v-model="reference" required>
    </label>
    <label v-for="field in metadataFields" :key="field">
      <span v-text="field.replaceAll('_', ' ')" />
      <input v-model="customMetadata[field]" required>
    </label>
    <button type="submit">Pay now</button>
  </form>

  <ReevitCheckout
    :public-key="import.meta.env.VITE_REEVIT_KEY ?? ''"
    :amount="checkoutAmount"
    :currency="props.currency"
    :email="email || undefined"
    :phone="phone || undefined"
    :customer-name="customerName || undefined"
    :reference="reference || undefined"
    :metadata="paymentMetadata"
    :payment-methods="['card', 'mobile_money']"
    :is-open="open"
    @success="onSuccess"
    @error="onError"
    @close="open = false"
  />
</template>
